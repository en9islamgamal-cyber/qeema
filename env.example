# GEMINI_API_KEY: Primary key (Required by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Secondary/tertiary key rotation pool keys
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Supporting visual & vocal model secrets (Optional fallbacks for custom external integrations)
ELEVENLABS_API_KEY=""
LEONARDO_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://example-service.run.app"

# SUPABASE: Enable durable cloud persistence.
SUPABASE_URL=""
SUPABASE_KEY=""

# YOUTUBE PUBLISHING: OAuth credential setup for background uploads.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
